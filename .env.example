# Copiá este archivo a .env.local para probar en tu computadora.
# Sin las variables de Supabase la plataforma corre en MODO DEMO (datos de ejemplo en el navegador).

# Supabase → Project Settings → API. Son claves PÚBLICAS: la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Subcarpeta de publicación. En GitHub Pages la pone el workflow ("/Filial-montpellier").
NEXT_PUBLIC_BASE_PATH=
