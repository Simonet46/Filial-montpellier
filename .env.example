# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase.
# Sin estas variables la plataforma corre en MODO DEMO con datos de ejemplo.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional (solo servidor, NUNCA con prefijo NEXT_PUBLIC_): habilita "Invitar usuario" en /admin/users
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: URL pública para los enlaces de correo (si no, se toma del request)
NEXT_PUBLIC_SITE_URL=https://filial.example.com
